local Proximity = Tabs.Main:AddLeftGroupbox("Nhấn")
Proximity:AddCheckbox("HigherInteract", {
	Text = "Tương Tác Cao Hơn",
	Default = false,
	Callback = function(v)
if v then
for _,v in pairs(workspace:GetDescendants()) do
if v:IsA("ProximityPrompt") then
v.MaxActivationDistance = v.MaxActivationDistance + 5
end
end
IncreasedDistance = workspace.DescendantAdded:Connect(function(v)
if v:IsA("ProximityPrompt") then
v.MaxActivationDistance = v.MaxActivationDistance + 5
end
end)
else
IncreasedDistance:Disconnect()
for _,v in pairs(workspace:GetDescendants()) do
if v:IsA("ProximityPrompt") then
v.MaxActivationDistance = v.MaxActivationDistance - 5
end
end
end
end})
Proximity:AddCheckbox("InstanceInteract", {
	Text = "Tương Tác Nhanh Chóng",
	Default = false,
	Callback = function(v)
