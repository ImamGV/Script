local Proximity = Tabs.Main:AddLeftGroupbox("Proximity")
Proximity:AddCheckbox("HigherInteract", {
	Text = "Higher Interact",
	Default = false,
	Callback = function(v)
if v then
for _,v in pairs(workspace:GetDescendants()) do
if v:IsA("ProximityPrompt") then
v.MaxActivationDistance = v.MaxActivationDistance + 5
end
end
IncreasedDistance = workspace.DescendantAdded:Connect(function(v)
if v:IsA("ProximityPrompt") then
v.MaxActivationDistance = v.MaxActivationDistance + 5
end
end)
else
IncreasedDistance:Disconnect()
for _,v in pairs(workspace:GetDescendants()) do
if v:IsA("ProximityPrompt") then
v.MaxActivationDistance = v.MaxActivationDistance - 5
end
end
end
end})
Proximity:AddCheckbox("InstanceInteract", {
	Text = "Instance Interact",
	Default = false,
	Callback = function(v)
if v then
for _,v in pairs(workspace:GetDescendants()) do
if v:IsA("ProximityPrompt") then
v.HoldDuration = 0
end
end
InstanceInteract = workspace.DescendantAdded:Connect(function(v)
if v:IsA("ProximityPrompt") then
v.HoldDuration = 0
end
end)
else
InstanceInteract:Disconnect()
end
end})
Proximity:AddCheckbox("ThrougherInteract", {
	Text = "Tương Tác Xuyên",
	Default = false,
	Callback = function(v)
