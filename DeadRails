if v:IsA("ProximityPrompt") then
v.MaxActivationDistance = v.MaxActivationDistance + 5
end
end
IncreasedDistance = workspace.DescendantAdded:Connect(function(v)
if v:IsA("ProximityPrompt") then
v.MaxActivationDistance = v.MaxActivationDistance + 5
end
end)
else
IncreasedDistance:Disconnect()
