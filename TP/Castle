-- Vampire Castle variables
local teleportPosition = Vector3.new(57, 3, -9000)
local teleportCount = 10
local delayTime = 0.1
-- Function to start repeated jumping
local function StartJump()
game.Players.LocalPlayer.Character:WaitForChild("Humanoid"):ChangeState(Enum.HumanoidStateType.Jumping)
end
local function TPVampireCastle()
    for i = 1, 10 do
        game.Players.LocalPlayer.Character:WaitForChild("HumanoidRootPart").CFrame = CFrame.new(Vector3.new(57, 3, -9000))
        task.wait(0.1)
    end

    local VampireCastle = workspace:FindFirstChild("VampireCastle")
    if VampireCastle and VampireCastle.PrimaryPart then
        for _, item in ipairs(workspace.RuntimeItems:GetDescendants()) do
            if item:IsA("Model") and item.Name == "MaximGun" then
                if (item.PrimaryPart.Position - VampireCastle.PrimaryPart.Position).Magnitude <= 500 then
                    MaximGun = item
                    break
                end
            end
        end

        if MaximGun then
            local Seat = MaximGun:FindFirstChild("VehicleSeat")
            if Seat then
                game.Players.LocalPlayer.Character:PivotTo(Seat.CFrame)
                Seat:Sit(game.Players.LocalPlayer.Character:WaitForChild("Humanoid"))
                task.wait(2)
                game.Players.LocalPlayer.Character:WaitForChild("Humanoid"):ChangeState(Enum.HumanoidStateType.Jumping)
                StartJump()
            else
                print("Not found maximgun")
            end
        else
            local FoundChair = nil
            for _, chair in ipairs(workspace.RuntimeItems:GetDescendants()) do
                if chair.Name == "Chair" then
                    local Seat = chair:FindFirstChild("Seat")
                    if Seat and Seat.Position.Z >= -9500 and Seat.Position.Z <= -9000 then
                        FoundChair = Seat
                        break
                    end
                end
            end

            if FoundChair then
                game.Players.LocalPlayer.Character:PivotTo(FoundChair.CFrame)
                FoundChair:Sit(game.Players.LocalPlayer.Character:WaitForChild("Humanoid"))
                task.wait(2)
                game.Players.LocalPlayer.Character:WaitForChild("Humanoid"):ChangeState(Enum.HumanoidStateType.Jumping)
                StartJump()
            else
                print("Not found chair.")
            end
        end
    else
        print("...")
    end
end
TPVampireCastle()
